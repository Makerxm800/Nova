{
  "name": "nova-explorer",
  "version": "1.0.0",
  "description": "Nova Explorer desktop file manager",
  "main": "electron/main.cjs",
  "author": "Nova",
  "license": "MIT",
  "scripts": {"start":"electron .", "dist":"electron-builder", "dist:win":"electron-builder --win nsis --x64", "dist:mac":"electron-builder --mac dmg", "dist:linux":"electron-builder --linux AppImage"},
  "devDependencies": {"electron":"^33.2.1", "electron-builder":"^25.1.8"},
  "build": {"appId":"com.nova.explorer", "productName":"Nova Explorer", "directories":{"buildResources":"build"}, "files":["electron/**/*","public/**/*","package.json"], "win":{"target":[{"target":"nsis","arch":["x64"]}],"artifactName":"Nova-Explorer-Setup-${version}.${ext}"}, "nsis":{"oneClick":false,"allowToChangeInstallationDirectory":true,"createDesktopShortcut":true,"createStartMenuShortcut":true}, "mac":{"target":"dmg"}, "linux":{"target":"AppImage","category":"Utility"}}
}
