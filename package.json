{
  "name": "nova-search",
  "version": "2.0.0",
  "description": "Nova Search — a private, on-device file search with real video and music players for Windows, macOS and Linux",
  "main": "electron/main.cjs",
  "author": "Nova",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "node scripts/dev-server.cjs",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg --publish never",
    "dist:linux": "electron-builder --linux AppImage --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.nova.search",
    "productName": "Nova Search",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/assets/icon-512.png",
      "artifactName": "Nova-Search-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nova Search"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "public/assets/icon-512.png",
      "category": "public.app-category.utilities",
      "artifactName": "Nova-Search-${version}-${arch}.${ext}",
      "darkModeSupport": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "public/assets/icon-512.png"
    },
    "artifactName": "Nova-Search-${version}-${os}-${arch}.${ext}"
  }
}
